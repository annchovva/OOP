<Window x:Class="FinancialSystem.UI.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FinancialSystem.UI" 
        Title="Панель управления менеджера" Height="700" Width="1000" 
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 1. Конвертеры (уже были) -->
        <local:BlockStatusConverter x:Key="BlockStatusConverter"/>
        <local:BlockColorConverter x:Key="BlockColorConverter"/>

        <!-- 2. ТОТ САМЫЙ НЕДОСТАЮЩИЙ СТИЛЬ ModernDataGridStyle -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Style.Resources>
                <!-- Стиль заголовков колонок внутри таблицы -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource EmeraldAccent}"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    <Setter Property="Height" Value="35"/>
                </Style>
                <!-- Стиль ячеек -->
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1A2ECC71"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>

        <!-- 3. Стиль вкладок (ваш старый код) -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" BorderThickness="0,0,0,2" Margin="0,0,20,10" Padding="10,5" Background="Transparent">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                          ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource EmeraldAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource EmeraldAccent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>



    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок системы -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="CORE BANKING SYSTEM" Foreground="{StaticResource EmeraldAccent}" FontSize="12" FontWeight="Bold"/>
            <TextBlock Text="ПАНЕЛЬ АДМИНИСТРИРОВАНИЯ" Style="{StaticResource HeaderStyle}" Margin="0,-5,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">

            <!-- Вкладка 1: Регистрация -->
            <TabItem Header="НОВЫЕ КЛИЕНТЫ">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <DataGrid x:Name="PendingUsersGrid" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ModernDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ЛОГИН ПОЛЬЗОВАТЕЛЯ" Binding="{Binding Login}" Width="*"/>
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="ОДОБРИТЬ" Click="ApproveUser_Click" 
                                                Style="{StaticResource EmeraldButtonStyle}" Height="28" FontSize="10"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- Вкладка 2: Заявки на работу -->
            <TabItem Header="ТРУДОУСТРОЙСТВО">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <DataGrid x:Name="JoinRequestsGrid" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ModernDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="СОТРУДНИК" Binding="{Binding User.Login}" Width="*"/>
                            <DataGridTextColumn Header="ПРЕДПРИЯТИЕ" Binding="{Binding Enterprise.Name}" Width="*"/>
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="ПРИНЯТЬ" Click="ApproveJoin_Click" 
                                                Style="{StaticResource EmeraldButtonStyle}" Height="28" FontSize="10"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- Вкладка 3: Зарплата -->
            <TabItem Header="ВЫПЛАТЫ">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <DataGrid x:Name="SalaryRequestsGrid" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ModernDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="СОТРУДНИК" Binding="{Binding User.Login}" Width="*"/>
                            <DataGridTextColumn Header="ОРГАНИЗАЦИЯ" Binding="{Binding Enterprise.Name}" Width="*"/>
                            <DataGridTemplateColumn Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="ВЫПЛАТИТЬ 50 000 ₽" Click="ApproveSalary_Click" 
                                                Style="{StaticResource EmeraldButtonStyle}" Height="28" FontSize="10"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- Вкладка 4: Счета -->
            <TabItem Header="УПРАВЛЕНИЕ СЧЕТАМИ">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <DataGrid x:Name="AllAccountsGrid" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ModernDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ВЛАДЕЛЕЦ" Binding="{Binding User.Login}" Width="120"/>
                                <DataGridTextColumn Header="НОМЕР СЧЕТА" Binding="{Binding AccountNumber}" Width="*"/>
                                <DataGridTextColumn Header="ТИП" Binding="{Binding Type}" Width="100"/>
                                <DataGridTextColumn Header="БАЛАНС" Binding="{Binding Balance, StringFormat={}{0:N2} ₽}" Width="120"/>
                                <DataGridTemplateColumn Header="СТАТУС" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IsBlocked, Converter={StaticResource BlockStatusConverter}}" 
                                                       Foreground="{Binding IsBlocked, Converter={StaticResource BlockColorConverter}}"
                                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="ИСТОРИЯ ОПЕРАЦИЙ" Click="ViewHistory_Click" Width="180" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                        <Button x:Name="BlockBtn" Content="БЛОКИРОВКА / РАЗБЛОКИРОВКА" Click="ToggleBlock_Click" Width="220" Style="{StaticResource EmeraldButtonStyle}" Background="#E74C3C"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
