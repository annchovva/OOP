<Window x:Class="FinancialSystem.UI.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель менеджера" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <TabControl x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
            <!-- Вкладка 1: Регистрация новых клиентов -->
            <TabItem Header="Регистрация">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Ожидают подтверждения регистрации" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="PendingUsersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Одобрить" Click="ApproveUser_Click" Background="#E8F5E9"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Заявки на трудоустройство -->
            <TabItem Header="Заявки на работу">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Заявки на вступление в предприятия" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="JoinRequestsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding User.Login}" Width="*"/>
                            <DataGridTextColumn Header="Предприятие" Binding="{Binding Enterprise.Name}" Width="*"/>
                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Принять" Click="ApproveJoin_Click" Background="#E3F2FD"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Запросы зарплаты -->
            <TabItem Header="Выплата зарплаты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Запросы на начисление зарплаты" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="SalaryRequestsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding User.Login}" Width="*"/>
                            <DataGridTextColumn Header="Предприятие" Binding="{Binding Enterprise.Name}" Width="*"/>
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Одобрить (50к)" Click="ApproveSalary_Click" Background="#FFF9C4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 4: Список предприятий (По ТЗ) -->
            <TabItem Header="Предприятия">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Список всех предприятий и сотрудников" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="EnterprisesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Кол-во сотрудников" Binding="{Binding Employees.Count}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Счета клиентов">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Все счета и вклады в системе" FontWeight="Bold" Margin="0,0,0,10"/>

                    <DataGrid x:Name="AllAccountsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Владелец" Binding="{Binding User.Login}" Width="120"/>
                            <DataGridTextColumn Header="Банк" Binding="{Binding Bank.Name}" Width="150"/>
                            <DataGridTextColumn Header="Номер счета" Binding="{Binding AccountNumber}" Width="*"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="80"/>
                            <DataGridTextColumn Header="Баланс" Binding="{Binding Balance, StringFormat={}{0:N2} ₽}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Заблочен" Binding="{Binding IsBlocked}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="📜 История операций" Click="ViewHistory_Click" Padding="15,7" Margin="0,0,10,0" Background="#F5F5F5"/>
                        <Button Content="🔒 Блок / Разблок" Click="ToggleBlock_Click" Padding="15,7" Background="#FFEBEE" Foreground="#B71C1C" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
