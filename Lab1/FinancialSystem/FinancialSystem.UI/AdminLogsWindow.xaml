<Window x:Class="FinancialSystem.UI.AdminLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FinancialSystem.UI"
        Title="Панель Администратора - Логи" 
        Height="450" Width="850" 
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Регистрируем наши конвертеры -->
        <local:InverseBoolToVisConverter x:Key="InverseVisibility"/>
        <local:StatusTextConverter x:Key="StatusConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Журнал действий всех пользователей" 
                   FontSize="20" FontWeight="Bold" 
                   Margin="0,0,0,15" Foreground="#2C3E50"/>

        <DataGrid x:Name="LogsGrid" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата/Время" 
                                    Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}" 
                                    Width="140"/>

                <DataGridTextColumn Header="Тип" 
                                    Binding="{Binding ActionType}" 
                                    Width="100"/>

                <DataGridTextColumn Header="Описание" 
                                    Binding="{Binding Details}" 
                                    Width="*"/>

                <DataGridTemplateColumn Header="Действие" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Используем наш InverseVisibility -->
                            <Button Content="Отменить" 
                                    Click="UndoBtn_Click" 
                                    Background="#FFCDD2" 
                                    Visibility="{Binding IsReversed, Converter={StaticResource InverseVisibility}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Используем наш StatusConverter -->
                <DataGridTextColumn Header="Статус" 
                                    Binding="{Binding IsReversed, Converter={StaticResource StatusConverter}}" 
                                    Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
