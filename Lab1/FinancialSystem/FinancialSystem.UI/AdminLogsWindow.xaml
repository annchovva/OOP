<Window x:Class="FinancialSystem.UI.AdminLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FinancialSystem.UI"
        Title="Панель Администратора - Логи" 
        Height="500" Width="950" 
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:InverseBoolToVisConverter x:Key="InverseVisibility"/>
        <local:StatusTextConverter x:Key="StatusConverter"/>

        <!-- Специальный стиль для кнопки отмены (Красная) -->
        <Style x:Key="UndoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Журнал действий системы" 
                   Style="{StaticResource HeaderStyle}" 
                   Grid.Row="0"/>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="LogsGrid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      Background="Transparent"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#252525"
                      Foreground="{StaticResource TextPrimary}"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column">

                <DataGrid.Resources>
                    <!-- Стиль заголовков -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource EmeraldAccent}"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="{StaticResource EmeraldAccent}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата/Время" 
                                        Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}" 
                                        Width="150"/>

                    <DataGridTemplateColumn Header="Тип" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#1A2ECC71" CornerRadius="4" Padding="5,2">
                                    <TextBlock Text="{Binding ActionType}" 
                                               Foreground="{StaticResource EmeraldAccent}" 
                                               HorizontalAlignment="Center" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Описание" 
                                        Binding="{Binding Details}" 
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Padding" Value="5"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Статус" 
                                        Binding="{Binding IsReversed, Converter={StaticResource StatusConverter}}" 
                                        Width="100"/>

                    <DataGridTemplateColumn Header="Действие" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Отменить" 
                                        Click="UndoBtn_Click" 
                                        Style="{StaticResource UndoButtonStyle}"
                                        Visibility="{Binding IsReversed, Converter={StaticResource InverseVisibility}}"
                                        Margin="5,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
