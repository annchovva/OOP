<Window x:Class="FinancialSystem.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Financial System — Авторизация" 
        Height="500" Width="450" 
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <!-- Фоновый декоративный элемент (опционально, для стиля) -->
        <Ellipse Fill="{StaticResource EmeraldAccent}" Width="300" Height="300" 
                 Margin="-150,-150,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" 
                 Opacity="0.05"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">

            <!-- Логотип или Иконка -->
            <Border Width="60" Height="60" Background="{StaticResource EmeraldAccent}" 
                    CornerRadius="15" Margin="0,0,0,20">
                <TextBlock Text="$" Foreground="Black" FontSize="36" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="ДОБРО ПОЖАЛОВАТЬ" 
                       Style="{StaticResource HeaderStyle}" 
                       HorizontalAlignment="Center" 
                       FontSize="20"/>

            <!-- Карточка формы -->
            <Border Style="{StaticResource CardStyle}" Padding="25">
                <StackPanel>
                    <TextBlock Text="ЛОГИН" FontSize="10" FontWeight="Bold" 
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                    <TextBox x:Name="LoginBox" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                    <TextBlock Text="ПАРОЛЬ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,25">
                        <!-- Поле для скрытого ввода -->
                        <PasswordBox x:Name="PasswordBox" VerticalContentAlignment="Center" Padding="5,0,35,0"/>

                        <!-- Поле для видимого ввода (по умолчанию скрыто) -->
                        <TextBox x:Name="PasswordVisibleBox" VerticalContentAlignment="Center" Padding="5,0,35,0" Visibility="Collapsed"/>

                        <!-- Кнопка-глазик -->
                        <Button x:Name="BtnShowPass" Content="👁" Style="{StaticResource EyeButtonStyle}"  Width="30" Height="25" HorizontalAlignment="Right"
                                PreviewMouseDown="BtnShowPass_PreviewMouseDown" 
                                PreviewMouseUp="BtnShowPass_PreviewMouseUp"/>
                    </Grid>

                    <Button Content="ВОЙТИ" 
                            Style="{StaticResource EmeraldButtonStyle}" 
                            Click="LoginButton_Click" 
                            Height="40" Margin="0,0,0,10"/>

                    <Button Content="Регистрация клиента" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Click="RegisterButton_Click" 
                            FontSize="12" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Сообщения об ошибках / Успехе -->
            <TextBlock x:Name="StatusLabel" 
                       Foreground="#E74C3C" 
                       HorizontalAlignment="Center" 
                       Margin="0,20,0,0" 
                       TextWrapping="Wrap" 
                       FontSize="12" 
                       TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
