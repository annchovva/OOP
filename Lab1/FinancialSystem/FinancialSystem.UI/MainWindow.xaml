<Window x:Class="FinancialSystem.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Financial System - Вход" Height="350" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Авторизация" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20" FontWeight="Bold"/>

            <TextBlock Text="Логин:"/>
            <TextBox x:Name="LoginBox" Margin="0,5,0,10" Height="25"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,20" Height="25"/>

            <Button Content="Войти" Click="LoginButton_Click" Height="35" Background="#2196F3" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
            <Button Content="Зарегистрироваться (Клиент)" Click="RegisterButton_Click" Height="30"/>

            <TextBlock x:Name="StatusLabel" Foreground="Red" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>

