<Window x:Class="FinancialSystem.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История транзакций" Height="500" Width="800" 
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ПОЛНАЯ ИСТОРИЯ ОПЕРАЦИЙ" Style="{StaticResource HeaderStyle}"/>
            <TextBlock Text="Все входящие и исходящие переводы по вашим счетам" 
                       Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,-15,0,0"/>
        </StackPanel>

        <!-- Таблица в карточке -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="HistoryGrid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#252525"
                      Foreground="{StaticResource TextPrimary}"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column">

                <DataGrid.Resources>
                    <!-- Стиль заголовков -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource EmeraldAccent}"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    </Style>

                    <!-- Стиль ячеек -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1A2ECC71"/>
                                <Setter Property="Foreground" Value="{StaticResource EmeraldAccent}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Дата -->
                    <DataGridTextColumn Header="ДАТА И ВРЕМЯ" 
                                        Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" 
                                        Width="150"/>

                    <!-- Отправитель -->
                    <DataGridTemplateColumn Header="ОТКУДА" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FromAccount.AccountNumber}" 
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Стрелочка -->
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="→" Foreground="{StaticResource EmeraldAccent}" 
                                           HorizontalAlignment="Center" FontWeight="Bold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Получатель -->
                    <DataGridTemplateColumn Header="КУДА" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ToAccount.AccountNumber}" 
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Сумма -->
                    <DataGridTemplateColumn Header="СУММА" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Amount, StringFormat={}{0:N2} ₽}" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource EmeraldAccent}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Кнопка закрытия -->
        <Button Content="Закрыть" 
                Grid.Row="2" 
                Style="{StaticResource SecondaryButtonStyle}" 
                Width="120" 
                HorizontalAlignment="Right" 
                Margin="0,20,0,0"
                Click="Close_Click"/>
    </Grid>
</Window>
