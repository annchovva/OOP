<Window x:Class="FinancialSystem.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История транзакций" Height="400" Width="650" WindowStartupLocation="CenterOwner">
    <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM HH:mm}}" Width="100"/>
            <DataGridTextColumn Header="Откуда" Binding="{Binding FromAccount.AccountNumber}" Width="*"/>
            <DataGridTextColumn Header="Куда" Binding="{Binding ToAccount.AccountNumber}" Width="*"/>
            <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2} ₽}" Width="100"/>
        </DataGrid.Columns>
    </DataGrid>
</Window>
