<Window x:Class="FinancialSystem.UI.OpenAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Открыть новый счет" Height="250" Width="400"
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" BorderThickness="1" BorderBrush="{StaticResource EmeraldAccent}">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="ОТКРЫТИЕ СЧЕТА" Foreground="{StaticResource EmeraldAccent}" 
                       FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="ВЫБЕРИТЕ БАНК" Foreground="{StaticResource TextSecondary}" 
                       FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>

            <!-- Используем наш красивый стиль ComboBox -->
            <ComboBox x:Name="BankComboBox" DisplayMemberPath="Name" 
                      Style="{StaticResource ModernComboBoxStyle}" Height="40" Margin="0,0,0,25"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="ОТМЕНА" Click="Cancel_Click" Grid.Column="0"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5,0" Height="40"/>
                <Button Content="ОТКРЫТЬ" Click="Confirm_Click" Grid.Column="1"
                        Style="{StaticResource EmeraldButtonStyle}" Margin="5,0,0,0" Height="40"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
