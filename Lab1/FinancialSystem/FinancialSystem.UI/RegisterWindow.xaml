<Window x:Class="FinancialSystem.UI.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BackgroundColor}">
        <Border Style="{StaticResource CardStyle}" Width="380" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="FinTech System" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Создайте новый аккаунт" FontSize="14" Foreground="Gray" TextAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Придумайте логин" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="RegUsernameTextBox" TextChanged="RegUsernameTextBox_TextChanged"/>
                <TextBlock x:Name="UsernameStatusLabel" FontSize="11" Margin="0,-12,0,15" Text="Введите логин" Foreground="Gray"/>

                <TextBlock Text="Придумайте пароль" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid>
                    <PasswordBox x:Name="RegPasswordBox" PasswordChanged="RegPasswordBox_PasswordChanged" Padding="8,0,35,0"/>
                    <TextBox x:Name="RegPasswordRevealTextBox" Visibility="Collapsed" TextChanged="RegPasswordRevealTextBox_TextChanged" Margin="0" Padding="8,0,35,0"/>
                    <Button x:Name="ToggleRegPasswordButton" Content="🔒" Width="30" Height="30" HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Click="ToggleRegPassword_Click"/>
                </Grid>
                <TextBlock x:Name="PasswordStatusLabel" FontSize="11" Margin="0,2,0,15" Text="Минимум 6 символов" Foreground="Gray"/>

                <TextBlock Text="Выберите роль" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="RoleComboBox" Height="35" Margin="0,0,0,25">
                    <ComboBoxItem Content="Client" IsSelected="True"/>
                    <ComboBoxItem Content="Manager"/>
                    <ComboBoxItem Content="Administrator"/>
                </ComboBox>

                <!-- IsDefault="True" позволяет нажать Enter для регистрации -->
                <Button x:Name="RegisterConfirmButton" Content="Зарегистрироваться" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="RegisterConfirm_Click" Margin="0,0,0,10" IsEnabled="False"/>

                <Button x:Name="BackToLoginButton" Content="Назад ко входу" Style="{StaticResource GhostButtonStyle}" Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>