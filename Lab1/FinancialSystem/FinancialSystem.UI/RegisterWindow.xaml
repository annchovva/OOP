<Window x:Class="FinancialSystem.UI.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация нового клиента" Height="400" Width="400"
        Background="{StaticResource BackgroundDark}" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <!-- заголовок -->
            <TextBlock Text="НОВЫЙ АККАУНТ" 
                       Style="{StaticResource HeaderStyle}" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <!-- карточка регистрации -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="ЛОГИН" FontSize="10" FontWeight="Bold" 
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                    <TextBox x:Name="RegLoginBox" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                    <TextBlock Text="ПАРОЛЬ (ОТ 4 СИМВОЛОВ)" FontSize="10" FontWeight="Bold" 
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>

                    <Grid Margin="0,0,0,25">
                        <!-- поле для скрытого ввода -->
                        <PasswordBox x:Name="RegPasswordBox" 
                                     VerticalContentAlignment="Center" 
                                     Padding="5,0,35,0"/>

                        <!-- поле для видимого ввода -->
                        <TextBox x:Name="RegPasswordVisibleBox" 
                                 VerticalContentAlignment="Center" 
                                 Padding="5,0,35,0" 
                                 Visibility="Collapsed"/>

                        <!-- кнопка-глазик -->
                        <Button Content="👁" 
                                Style="{StaticResource EyeButtonStyle}"
                                Width="30" Height="25" 
                                HorizontalAlignment="Right"
                                PreviewMouseDown="BtnShowPass_PreviewMouseDown" 
                                PreviewMouseUp="BtnShowPass_PreviewMouseUp"/>
                    </Grid>

                    <Button Content="СОЗДАТЬ АККАУНТ" 
                            Style="{StaticResource EmeraldButtonStyle}" 
                            Click="RegisterConfirm_Click" 
                            Height="40"/>
                </StackPanel>
            </Border>

            <Button Content="Назад ко входу" 
                    Style="{StaticResource SecondaryButtonStyle}" 
                    Click="Back_Click" 
                    Margin="0,15,0,0" 
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
