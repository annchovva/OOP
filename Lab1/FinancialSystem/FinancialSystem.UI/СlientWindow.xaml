<Window x:Class="FinancialSystem.UI.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FinTech System - Личный кабинет" Height="650" Width="1100" 
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundColor}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ (SIDEBAR) -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryColor}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="FINTECH" Foreground="White" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Row="1" Margin="10,20,0,0">
                    <Button Content="🏠 Дашборд" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Dashboard_Click"/>
                    <Button Content="🏦 Банки" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Banks_Click"/>
                    <Button Content="💳 Мои счета" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Accounts_Click"/>
                    <Button Content="💸 Переводы" Style="{StaticResource SidebarButtonStyle}" Click="Nav_Transfers_Click"/>
                    <Button Content="📜 История" Style="{StaticResource SidebarButtonStyle}" Click="Nav_History_Click"/>
                </StackPanel>

                <Button Grid.Row="2" Content="🚪 Выход" Style="{StaticResource SidebarButtonStyle}" 
                        Margin="10,0,0,20" Click="Logout_Click"/>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ (КОНТЕНТ) -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок (ИСПРАВЛЕНО: Margin) -->
            <StackPanel Margin="0,0,0,25">
                <TextBlock x:Name="WelcomeText" Text="Добро пожаловать, Пользователь!" FontSize="28" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Роль: Клиент" Foreground="#777" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Область переключения вкладок -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>

                <!-- 0: ДАШБОРД -->
                <TabItem>
                    <WrapPanel>
                        <Border Style="{StaticResource CardStyle}" Width="300" Height="150" Margin="0,0,20,20">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ваш общий баланс" Foreground="#888" FontSize="14" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TotalBalanceText" Text="0,00 ₽" FontSize="36" FontWeight="Bold" Foreground="#27AE60"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </TabItem>

                <!-- 1: БАНКИ -->
                <TabItem>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Доступные банки" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                            <DataGrid x:Name="BanksDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="Название финансовой организации" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- 2: СЧЕТА -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Панель открытия счета -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20" Padding="20,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Открыть новый счет в:" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="BanksComboBox" Width="250" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,15,0"/>
                                <Button Content="Открыть счет" Style="{StaticResource PrimaryButtonStyle}" Width="150" Click="OpenAccount_Click"/>
                            </StackPanel>
                        </Border>
                        <!-- Список счетов -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <DataGrid x:Name="AccountsDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Номер счета" Binding="{Binding Number}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Банк" Binding="{Binding Bank.Name}" Width="*"/>
                                    <DataGridTextColumn Header="Баланс" Binding="{Binding Balance, StringFormat={}{0:N2} ₽}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Действия" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="+" Click="Deposit_Click" Tag="{Binding Id}" Width="30" Height="30" Margin="2" Background="#E8F5E9" Foreground="#2E7D32" FontWeight="Bold" ToolTip="Пополнить"/>
                                                    <Button Content="-" Click="Withdraw_Click" Tag="{Binding Id}" Width="30" Height="30" Margin="2" Background="#FFEBEE" Foreground="#C62828" FontWeight="Bold" ToolTip="Снять"/>
                                                    <Button Content="Закрыть счет" Style="{StaticResource GhostButtonStyle}" Click="CloseAccount_Click" Tag="{Binding Id}" Foreground="#E74C3C" Margin="15,0,0,0" FontSize="12"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 3: ПЕРЕВОДЫ -->
                <TabItem>
                    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Left" Width="450" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Новый денежный перевод" FontSize="18" FontWeight="Bold" Margin="0,0,0,25"/>

                            <TextBlock Text="Выберите ваш счет" Foreground="#666" Margin="0,0,0,5"/>
                            <ComboBox x:Name="SourceAccountComboBox" DisplayMemberPath="Number" SelectedValuePath="Id" Margin="0,0,0,20"/>

                            <TextBlock Text="Номер счета получателя" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBox x:Name="TargetAccountNumberTextBox" Margin="0,0,0,20"/>

                            <TextBlock Text="Сумма перевода (₽)" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBox x:Name="TransferAmountTextBox" Margin="0,0,0,25" FontWeight="Bold" FontSize="16"/>

                            <Button Content="Подтвердить и отправить" Style="{StaticResource PrimaryButtonStyle}" Height="45" Click="TransferMoney_Click"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- 4: ИСТОРИЯ -->
                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20" Padding="15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="История операций по счету:" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="HistoryAccountComboBox" Width="300" DisplayMemberPath="Number" SelectedValuePath="Id" SelectionChanged="HistoryAccountComboBox_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <DataGrid x:Name="TransactionsDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата и время" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/>
                                    <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2} ₽}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
