<Window x:Class="FinancialSystem.UI.AccountHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История транзакций" Height="400" Width="600">
    <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
            <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2} ₽}" Width="100"/>
            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>
</Window>
