<Window x:Class="FinancialSystem.UI.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый перевод" Height="250" Width="350" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Номер счета получателя:" Margin="0,0,0,5"/>
            <TextBox x:Name="ToAccountTextBox" Padding="5" Margin="0,0,0,15"/>

            <TextBlock Text="Сумма (₽):" Margin="0,0,0,5"/>
            <TextBox x:Name="AmountTextBox" Padding="5" Margin="0,0,0,20"/>

            <Button Content="🚀 Отправить" Click="Transfer_Click" Background="#4CAF50" Foreground="White" Height="35"/>
        </StackPanel>
    </Grid>
</Window>
