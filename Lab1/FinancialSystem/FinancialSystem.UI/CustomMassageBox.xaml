<Window x:Class="FinancialSystem.UI.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сообщение" Height="220" Width="420"
        Background="Transparent" 
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" WindowStyle="None" ResizeMode="NoResize"> 

    <Border Background="{StaticResource BackgroundDark}" 
            BorderBrush="{StaticResource EmeraldAccent}" 
            BorderThickness="2" 
            CornerRadius="15">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="MessageText" 
                       Text="Текст сообщения" 
                       Foreground="White" FontSize="15" 
                       TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>

            <StackPanel Grid.Row="1" Margin="0,15,0,0">
                <Button x:Name="OkBtn" Content="ОК" Click="OkButton_Click" 
                        Style="{StaticResource EmeraldButtonStyle}" Width="120" Height="38"/>

                <StackPanel x:Name="YesNoStack" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Button Content="ДА" Click="YesButton_Click" Style="{StaticResource EmeraldButtonStyle}" 
                            Width="110" Height="38" Margin="0,0,15,0"/>
                    <Button Content="НЕТ" Click="NoButton_Click" Style="{StaticResource SecondaryButtonStyle}" 
                            Foreground="#E74C3C" BorderBrush="#E74C3C" Width="110" Height="38"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
