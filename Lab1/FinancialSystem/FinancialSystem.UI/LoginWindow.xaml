<Window x:Class="FinancialSystem.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BackgroundColor}">
        <Border Style="{StaticResource CardStyle}" Width="350" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="FinTech System" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Войдите в личный кабинет" FontSize="14" Foreground="Gray" TextAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Логин" FontWeight="SemiBold"/>
                <TextBox x:Name="UsernameTextBox" />

                <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <Grid Margin="0,0,0,15">
                    <PasswordBox x:Name="PasswordBox" Padding="8,5,35,5"/>
                    <TextBox x:Name="PasswordRevealTextBox" Padding="8,5,35,5" Visibility="Collapsed" Margin="0"/>
                    <Button x:Name="TogglePasswordButton" Content="🔒" Width="30" Height="30" HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Click="TogglePassword_Click"/>
                </Grid>

                <!-- IsDefault="True" позволяет нажать Enter для входа -->
                <Button x:Name="LoginButton" Content="Войти" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="LoginButton_Click" Margin="0,10,0,10"/>

                <Button x:Name="RegisterButton" Content="Регистрация" Style="{StaticResource GhostButtonStyle}" Click="RegisterButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
