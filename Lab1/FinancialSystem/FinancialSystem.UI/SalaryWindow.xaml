<Window x:Class="FinancialSystem.UI.SalaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Зарплатный проект" Height="500" Width="650" 
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Тот самый стиль, который ищет система -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Style.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource EmeraldAccent}"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1A2ECC71"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>


    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="WORK &amp; SALARY" Foreground="{StaticResource EmeraldAccent}" FontSize="12" FontWeight="Bold"/>
            <TextBlock Text="УПРАВЛЕНИЕ ЗАРПЛАТОЙ" Style="{StaticResource HeaderStyle}" Margin="0,-5,0,0"/>
        </StackPanel>

        <!-- Основной контент -->
        <Grid Grid.Row="1">

            <!-- СЕКЦИЯ 1: Если пользователь еще НЕ в штате -->
            <Border x:Name="NotEmployedPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="ВЫ ЕЩЕ НЕ ТРУДОУСТРОЕНЫ" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Выберите предприятие из списка ниже, чтобы отправить заявку на вступление в штат." 
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <TextBlock Text="ДОСТУПНЫЕ ПРЕДПРИЯТИЯ" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="EnterpriseComboBox" DisplayMemberPath="Name" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,20" Height="40" VerticalContentAlignment="Center"/>

                    <Button Content="ОТПРАВИТЬ ЗАЯВКУ" Click="JoinEnterprise_Click" 
                            Style="{StaticResource EmeraldButtonStyle}" Height="45"/>
                </StackPanel>
            </Border>

            <!-- СЕКЦИЯ 2: Если пользователь уже сотрудник -->
            <Grid x:Name="EmployedPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Инфо о работе -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="CurrentEnterpriseText" Text="Ваше предприятие: Название" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Статус: Активный сотрудник" Foreground="{StaticResource EmeraldAccent}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Новая кнопка увольнения -->
                            <Button Content="УВОЛИТЬСЯ" Click="Resign_Click" 
                    Style="{StaticResource SecondaryButtonStyle}" 
                    Foreground="#E74C3C" BorderBrush="#E74C3C" 
                    Padding="15,5" Margin="0,0,10,0"/>

                            <Button Content="ЗАПРОСИТЬ ВЫПЛАТУ" Click="RequestPayment_Click" 
                    Style="{StaticResource SecondaryButtonStyle}" Padding="15,5"/>
                        </StackPanel>
                        
                        <Button Content="ЗАПРОСИТЬ ВЫПЛАТУ" Click="RequestPayment_Click" 
                                HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Padding="15,5"/>
                    </Grid>
                </Border>

                <!-- Список выплат -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="ОДОБРЕННЫЕ ВЫПЛАТЫ" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                        <DataGrid x:Name="ApprovedPaymentsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                                  Style="{StaticResource ModernDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="СУММА" Binding="{Binding Amount, StringFormat={}{0:N2} ₽}" Width="120"/>
                                <DataGridTextColumn Header="ДАТА ОДОБРЕНИЯ" Binding="{Binding RequestedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="*"/>
                                <DataGridTemplateColumn Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="ПОЛУЧИТЬ" Click="ClaimSalary_Click" 
                                                    Style="{StaticResource EmeraldButtonStyle}" Height="24" FontSize="9" Padding="5,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Выбор счета для зачисления -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,15,0,0" Padding="15,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="СЧЕТ ДЛЯ ЗАЧИСЛЕНИЯ:" VerticalAlignment="Center" Margin="0,0,15,0" 
                                   Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold"/>
                        <ComboBox x:Name="AccountsComboBox" DisplayMemberPath="AccountNumber" Style="{StaticResource ModernComboBoxStyle}"  Width="250" Height="35" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
