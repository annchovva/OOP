<Window x:Class="FinancialSystem.UI.OpenDepositWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Открыть вклад" Height="350" Width="350" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Выберите банк:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="BankComboBox" DisplayMemberPath="Name" Margin="0,0,0,15" Padding="5"/>

            <TextBlock Text="Сумма вклада (₽):" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="AmountBox" Margin="0,0,0,15" Text="1000" Padding="5"/>

            <TextBlock Text="Процентная ставка (% годовых):" FontWeight="Bold" Margin="0,0,0,5"/>
            <Slider x:Name="RateSlider" Minimum="1" Maximum="20" Value="5" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding Value, ElementName=RateSlider, StringFormat={}{0}%}" 
                       HorizontalAlignment="Center" FontSize="16" Foreground="#2196F3" Margin="0,5,0,15"/>

            <Button Content="💰 Открыть вклад" Click="OpenDeposit_Click" 
                    Background="#4CAF50" Foreground="White" Padding="10" FontWeight="Bold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
