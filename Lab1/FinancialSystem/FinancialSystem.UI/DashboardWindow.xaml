<Window x:Class="FinancialSystem.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FINANCE SYSTEM — Панель управления" 
        Height="650" Width="1100" 
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- левая панель -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top">
                    <!-- логотип -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <Border Width="35" Height="35" CornerRadius="8" Background="{StaticResource EmeraldAccent}">
                            <TextBlock Text="$" Foreground="Black" FontWeight="Bold" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
                        </Border>
                        <TextBlock Text="FINANCE" Foreground="White" FontSize="18" FontWeight="Bold" 
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Text="SYSTEM" Foreground="{StaticResource EmeraldAccent}" FontSize="18" 
                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </StackPanel>

                    <!-- карточка информации -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,25" Background="#252525">
                        <StackPanel>
                            <TextBlock x:Name="UserInfoLabel" Text="Пользователь: ..." FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="UserRoleLabel" Text="Роль: ..." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                            <TextBlock x:Name="UserStatusText" Text="Статус: ..." FontSize="11" Foreground="{StaticResource EmeraldAccent}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- кнопки меню -->
                    <TextBlock Text="ОСНОВНОЕ" FontSize="10" FontWeight="Bold" Foreground="#555" Margin="5,0,0,10"/>

                    <Button x:Name="AccountsBtn" Content="🏠 Мои счета" 
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left"
                            Margin="0,0,0,10" Click="AccountsBtn_Click"/>

                    <Button x:Name="SalaryBtn" Content="💼 Зарплатный проект" 
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left"
                            Margin="0,0,0,10" Click="SalaryBtn_Click"/>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,10"/>

                    <!-- панели управления (админ/менеджер) -->
                    <TextBlock x:Name="AdminSectionHeader" Text="АДМИНИСТРИРОВАНИЕ" FontSize="10" FontWeight="Bold" Foreground="#555" Margin="5,10,0,10" Visibility="Collapsed"/>

                    <Button x:Name="ManagerPanelBtn" Content="🛠 Панель Менеджера" 
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left"
                            BorderBrush="#3498DB" Foreground="#3498DB"
                            Margin="0,0,0,10" Click="ManagerPanelBtn_Click" Visibility="Collapsed"/>

                    <Button x:Name="AdminPanelBtn" Content="📜 Логи Системы" 
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left"
                            BorderBrush="#E74C3C" Foreground="#E74C3C"
                            Margin="0,0,0,10" Click="AdminPanelBtn_Click" Visibility="Collapsed"/>
                </StackPanel>

                <!-- выход -->
                <Button Content="Выйти из системы" DockPanel.Dock="Bottom" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        BorderBrush="#555" Foreground="#999"
                        VerticalAlignment="Bottom" Click="Logout_Click"/>
            </DockPanel>
        </Border>

        <!-- основная область -->
        <Grid Grid.Column="1" Margin="30">

            <StackPanel x:Name="WelcomeArea" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Добро пожаловать в систему" FontSize="32" FontWeight="Light" Opacity="0.5" HorizontalAlignment="Center"/>
                <TextBlock Text="Выберите раздел в меню слева для начала работы" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- счета -->
            <Grid x:Name="AccountsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="+ Новый счет" Style="{StaticResource EmeraldButtonStyle}" Click="OpenAccountBtn_Click" Margin="0,0,12,0"/>
                    <Button Content="💰 Открыть вклад" Style="{StaticResource EmeraldButtonStyle}" Click="OpenDepositBtn_Click" Margin="0,0,12,0"/>
                    <Button Content="📊 Список банков" Style="{StaticResource SecondaryButtonStyle}" Click="ViewBanksBtn_Click"/>
                </StackPanel>

                <!-- список счетов -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <DataGrid x:Name="AccountsList" 
                              Style="{StaticResource ModernDataGridStyle}"
                              Foreground="{StaticResource TextPrimary}"
                              RowBackground="Transparent"
                              SelectionUnit="FullRow"
                              SelectionMode="Single"
                              IsReadOnly="True">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="НОМЕР СЧЕТА" Binding="{Binding AccountNumber}" Width="150"/>
                            <DataGridTemplateColumn Header="ТИП" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,2" CornerRadius="4" Background="#1AFFFFFF" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="БАЛАНС" Binding="{Binding Balance, StringFormat={}{0:N2} ₽}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="Foreground" Value="{StaticResource EmeraldAccent}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="БАНК" Binding="{Binding Bank.Name}" Width="150"/>

                            <DataGridTemplateColumn Header="СТАТУС" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource EmeraldAccent}" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="StatusTxt" Text="Активен" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                <Setter TargetName="StatusDot" Property="Fill" Value="#E74C3C"/>
                                                <Setter TargetName="StatusTxt" Property="Text" Value="Заблокирован"/>
                                                <Setter TargetName="StatusTxt" Property="Foreground" Value="#E74C3C"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="💸 Перевести" Style="{StaticResource EmeraldButtonStyle}" Click="TransferBtn_Click" Margin="0,0,12,0"/>
                    <Button Content="📈 Начислить %" Style="{StaticResource SecondaryButtonStyle}" Click="AccrueBtn_Click" Margin="0,0,12,0"/>
                    <Button Content="📜 История" Style="{StaticResource SecondaryButtonStyle}" Click="HistoryBtn_Click" Margin="0,0,12,0"/>
                    <Button Content="❌ Закрыть счет" Style="{StaticResource SecondaryButtonStyle}" BorderBrush="#E74C3C" Foreground="#E74C3C" Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
