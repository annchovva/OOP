<Window x:Class="FinancialSystem.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель управления" Height="500" Width="850" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая навигационная панель -->
        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,0,1,0" Padding="15">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="FINANCE SYSTEM" FontSize="18" FontWeight="Bold" Foreground="#2196F3" Margin="0,0,0,20"/>

                    <TextBlock x:Name="UserInfoLabel" Text="Пользователь: ..." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock x:Name="UserRoleLabel" Text="Роль: ..." FontSize="11" Foreground="Gray" Margin="0,0,0,20"/>

                    <Button x:Name="AccountsBtn" Content="🏠 Мои счета" Margin="0,5" Padding="8" Click="AccountsBtn_Click" HorizontalContentAlignment="Left"/>
                    <Button x:Name="TransactionsBtn" Content="💸 Переводы" Margin="0,5" Padding="8" Click="TransactionsBtn_Click" HorizontalContentAlignment="Left"/>

                    <Separator Margin="0,15"/>

                    <!-- Кнопка Менеджера (Синяя) -->
                    <Button x:Name="ManagerPanelBtn" 
                            Content="🛠 Панель Менеджера" 
                            Margin="0,5" Padding="8" 
                            Visibility="Collapsed" 
                            Background="#E3F2FD"
                            HorizontalContentAlignment="Left"
                            Click="ManagerPanelBtn_Click"/>

                    <!-- Кнопка Администратора (Красная) -->
                    <Button x:Name="AdminPanelBtn" 
                            Content="📜 Логи Системы (Админ)" 
                            Margin="0,5" Padding="8" 
                            Visibility="Collapsed" 
                            Background="#FFEBEE"
                            HorizontalContentAlignment="Left"
                            Click="AdminPanelBtn_Click"/>
                </StackPanel>

                <Button Content="Выход" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,20,0,0" Padding="5" Click="Logout_Click"/>
            </DockPanel>
        </Border>

        <!-- Основная область контента -->
        <Grid Grid.Column="1" Margin="25">
            <!-- Приветствие -->
            <StackPanel x:Name="WelcomeArea" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Добро пожаловать!" FontSize="28" FontWeight="Light" HorizontalAlignment="Center"/>
                <TextBlock x:Name="UserStatusText" Text="Ваш аккаунт активен" Foreground="#4CAF50" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Панель счетов -->
            <Grid x:Name="AccountsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="+ Открыть счет" Click="OpenAccountBtn_Click" Padding="12,6" Background="#4CAF50" Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                    <Button Content="Список банков" Click="ViewBanksBtn_Click" Padding="12,6"/>
                </StackPanel>

                <DataGrid x:Name="AccountsList" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#DDD">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер счета" Binding="{Binding AccountNumber}" Width="*"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
                        <DataGridTextColumn Header="Баланс" Binding="{Binding Balance, StringFormat={}{0:N2} ₽}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Банк" Binding="{Binding Bank.Name}" Width="150"/>
                        </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
