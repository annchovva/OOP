<Window x:Class="VectorEditor.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VectorEditor.WPF"
        Title="Vector Editor (ЛР2 + ЛР3)" Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть" Click="MenuOpen_Click"/>
                <MenuItem Header="Сохранить" Click="MenuSave_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Header="Отменить (Undo)" Click="MenuUndo_Click" />
                <MenuItem Header="Вернуть (Redo)" Click="MenuRedo_Click" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Инструменты -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0" Background="#F0F0F0">
                <StackPanel Margin="5">
                    <TextBlock Text="Инструменты" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox x:Name="ToolsListBox"
                             SelectionChanged="ToolsListBox_SelectionChanged"
                             DisplayMemberPath="Name"/>
                </StackPanel>
            </Border>

            <!-- Холст -->
            <Border Grid.Column="1" Background="DarkGray" ClipToBounds="True">
                <Border Margin="20" Background="White">
                    <local:EditorCanvas x:Name="MainCanvas" />
                </Border>
            </Border>

            <!-- Свойства -->
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1,0,0,0" Background="#F0F0F0">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Свойства выделения" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>

                        <TextBlock Text="Толщина линии:"/>
                        <Slider x:Name="ThicknessSlider"
                                Minimum="1"
                                Maximum="20"
                                Value="2"
                                PreviewMouseDown="Slider_PreviewMouseDown"
                                PreviewMouseUp="Slider_PreviewMouseUp"
                                ValueChanged="Property_Changed"/>

                        <TextBlock Text="Цвет линии:" Margin="0,10,0,0"/>
                        <WrapPanel x:Name="StrokePalette" Margin="0,5,0,0"/>

                        <TextBlock Text="Текущий цвет линии:" Margin="0,5,0,0"/>
                        <Border x:Name="StrokePreview"
                                Height="24"
                                BorderBrush="Black"
                                BorderThickness="1"
                                Margin="0,3,0,0"/>

                        <TextBlock Text="Цвет заливки:" Margin="0,10,0,0"/>
                        <WrapPanel x:Name="FillPalette" Margin="0,5,0,0"/>

                        <TextBlock Text="Текущий цвет заливки:" Margin="0,5,0,0"/>
                        <Border x:Name="FillPreview"
                                Height="24"
                                BorderBrush="Black"
                                BorderThickness="1"
                                Margin="0,3,0,0"/>

                        <TextBlock Text="Вращение (градусы):" Margin="0,10,0,0"/>
                        <Slider x:Name="RotationSlider"
                                Minimum="0"
                                Maximum="360"
                                Value="0"
                                PreviewMouseDown="Slider_PreviewMouseDown"
                                PreviewMouseUp="Slider_PreviewMouseUp"
                                ValueChanged="Property_Changed" />

                        <Button Content="Удалить фигуры"
                                Margin="0,15,0,0"
                                Background="#FFDCDC"
                                Click="DeleteShapes_Click"/>

                        <Separator Margin="0,20"/>

                        <TextBlock Text="Слои" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>
                        <ListBox x:Name="LayersListBox"
                                 DisplayMemberPath="Name"
                                 Height="120"
                                 Margin="0,0,0,5"
                                 SelectionChanged="LayersListBox_SelectionChanged"/>

                        <UniformGrid Columns="2">
                            <Button Content="Добавить" Click="AddLayer_Click" Margin="2"/>
                            <Button Content="Удалить" Click="RemoveLayer_Click" Margin="2"/>
                            <Button Content="Выше ↑" Click="MoveLayerUp_Click" Margin="2"/>
                            <Button Content="Ниже ↓" Click="MoveLayerDown_Click" Margin="2"/>
                            <Button Content="В этот слой"
                                    Click="MoveToLayer_Click"
                                    Margin="2"
                                    Background="#E1F5FE"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
