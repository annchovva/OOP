<Window x:Class="MyPaint.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyPaint.WPF"
        Title="MyPaint" Height="700" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Background="#EEE" VerticalAlignment="Center">
            <Button Content="Line" Width="80" Margin="5" Click="BtnLine_Click"/>
            <Button Content="Rect" Width="80" Margin="5" Click="BtnRect_Click"/>
            <Button Content="Ellipse" Width="80" Margin="5" Click="BtnEllipse_Click"/>

            <Separator Width="10"/>

            <TextBlock Text="Fill:" VerticalAlignment="Center" Margin="5,0"/>
            <Button x:Name="FillColorButton" Content="White" Width="90" Margin="5" Click="FillColorButton_Click"/>

            <TextBlock Text="Stroke:" VerticalAlignment="Center" Margin="5,0"/>
            <Button x:Name="StrokeColorButton" Content="Black" Width="90" Margin="5" Click="StrokeColorButton_Click"/>

            <TextBlock Text="Width:" VerticalAlignment="Center" Margin="5,0"/>
            <ComboBox x:Name="StrokeWidthBox" Width="70" Margin="5" SelectionChanged="StrokeWidthBox_SelectionChanged">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="8"/>
                <ComboBoxItem Content="12"/>
            </ComboBox>
        </StackPanel>

        <local:DrawingSurface x:Name="Surface"
                              Grid.Row="1"
                              Background="White"
                              MouseLeftButtonDown="Surface_MouseLeftButtonDown"
                              MouseMove="Surface_MouseMove"
                              MouseLeftButtonUp="Surface_MouseLeftButtonUp"/>
    </Grid>
</Window>
